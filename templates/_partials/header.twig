{# Pages chosen in Globals → Navigation → Main navigation #}
{% set navPages = navigation.mainNavigation.all() ?? [] %}
{% set brandName = siteSettings.companyName ?? null ?: 'Kickstart' %}

{% set linkBase = 'text-sm font-medium transition-colors' %}

<header class="sticky top-0 z-50 w-full border-b border-zinc-200/70 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="{{ siteUrl() }}" class="group flex items-center gap-2.5" aria-label="{{ brandName }} – home">
      <span class="flex size-8 items-center justify-center rounded-lg bg-zinc-900 text-sm font-bold text-white transition-transform group-hover:-rotate-6" aria-hidden="true">
        {{ brandName|first|upper }}
      </span>
      <span class="text-base font-semibold tracking-tight text-zinc-900">{{ brandName }}</span>
    </a>

    {% if navPages|length %}
      <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
        {% for page in navPages %}
          {% set isActive = entry and (entry.id == page.id or entry.isDescendantOf(page)) %}
          <a
            href="{{ page.url }}"
            class="{{ linkBase }} {{ isActive ? 'text-zinc-900' : 'text-zinc-500 hover:text-zinc-900' }}"
            {{ isActive ? 'aria-current="page"' }}
          >
            {{ page.title }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="flex items-center gap-3">
      {% include '_partials/language-switcher.twig' with { entry: entry ?? null } only %}

      {% if navPages|length %}
        <button
          type="button"
          class="-mr-2 rounded-md p-2 text-zinc-500 hover:text-zinc-900 md:hidden"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Toggle menu"
          data-nav-toggle
        >
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>

  {% if navPages|length %}
    <nav id="mobile-nav" class="hidden border-t border-zinc-200/70 px-4 py-3 sm:px-6 md:hidden" aria-label="Mobile navigation">
      {% for page in navPages %}
        {% set isActive = entry and (entry.id == page.id or entry.isDescendantOf(page)) %}
        <a
          href="{{ page.url }}"
          class="block rounded-md px-2 py-2.5 {{ linkBase }} {{ isActive ? 'text-zinc-900' : 'text-zinc-500 hover:text-zinc-900' }}"
          {{ isActive ? 'aria-current="page"' }}
        >
          {{ page.title }}
        </a>
      {% endfor %}
    </nav>

    <script>
      (() => {
        const btn = document.querySelector("[data-nav-toggle]");
        const menu = document.getElementById("mobile-nav");
        btn?.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          menu.classList.toggle("hidden", open);
        });
      })();
    </script>
  {% endif %}
</header>
