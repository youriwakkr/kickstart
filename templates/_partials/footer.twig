{% set footerPages = craft.entries()
  .section('pages')
  .limit(5)
  .all() %}

<footer class="mt-auto w-full border-t border-zinc-200 bg-zinc-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm space-y-3">
        <a href="{{ siteUrl() }}" class="flex items-center gap-2.5">
          <span class="flex size-7 items-center justify-center rounded-md bg-zinc-900 text-xs font-bold text-white">K</span>
          <span class="text-sm font-semibold tracking-tight text-zinc-900">Kickstart</span>
        </a>
        <p class="text-sm leading-relaxed text-zinc-500">
          A clean starting point for Craft CMS 5 projects.
        </p>
      </div>

      {% if footerPages|length %}
        <nav aria-label="Footer navigation">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {% for page in footerPages %}
              <li>
                <a href="{{ page.url }}" class="text-zinc-500 transition-colors hover:text-zinc-900">{{ page.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-zinc-200 pt-6 text-xs text-zinc-400 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {{ now|date('Y') }} Kickstart</p>
      <p>Built with Craft CMS</p>
    </div>
  </div>
</footer>
