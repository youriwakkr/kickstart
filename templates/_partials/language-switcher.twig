<nav aria-label="Language selection" class="inline-flex items-center gap-2 text-xs tracking-wider uppercase font-medium">
  {% for site in craft.app.sites.getAllSites() %}
    {% set targetUrl = null %}

    {% if entry is defined and entry %}
      {% set localizedEntry = craft.entries()
        .id(entry.id)
        .siteId(site.id)
        .status(null)
        .one() %}

      {% if localizedEntry and localizedEntry.enabled and localizedEntry.enabledForSite %}
        {% set targetUrl = localizedEntry.getUrl() %}
      {% endif %}
    {% endif %}

    {% set targetUrl = targetUrl ?? site.getBaseUrl() %}
    {% set isCurrent = currentSite.handle == site.handle %}

    {% if isCurrent %}
      <span aria-current="page" class="text-white font-semibold border-b border-white pb-0.5">
        {{ site.language[:2]|upper }}
      </span>
    {% else %}
      <a
        href="{{ targetUrl }}"
        hreflang="{{ site.language }}"
        class="text-zinc-400 hover:text-white transition-colors pb-0.5"
      >
        {{ site.language[:2]|upper }}
      </a>
    {% endif %}

    {% if not loop.last %}
      <span class="text-zinc-600 select-none">/</span>
    {% endif %}
  {% endfor %}
</nav>