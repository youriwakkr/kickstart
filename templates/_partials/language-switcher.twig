<nav aria-label="Language selection" class="flex items-center gap-3 text-sm">
  {% for site in craft.app.sites.getAllSites() %}
    {% set targetUrl = null %}

    {# If the current page is an entry, find its localized peer #}
    {% if entry is defined and entry %}
      {% set localizedEntry = craft.entries()
        .id(entry.id)
        .siteId(site.id)
        .status(null)
        .one() %}

      {% if localizedEntry and localizedEntry.enabled and localizedEntry.enabledForSite %}
        {% set targetUrl = localizedEntry.getUrl() %}
      {% endif %}
    {% endif %}

    {# Fallback to the target site's base URL (e.g. for static routes or missing translations) #}
    {% set targetUrl = targetUrl ?? site.getBaseUrl() %}
    {% set isCurrent = currentSite.handle == site.handle %}

    {% if isCurrent %}
      <span
        aria-current="page"
        class="font-semibold text-slate-900 border-b-2 border-slate-900 pb-0.5"
      >
        {{ site.name }}
      </span>
    {% else %}
      <a
        href="{{ targetUrl }}"
        hreflang="{{ site.language }}"
        class="text-slate-500 hover:text-slate-900 transition-colors pb-0.5"
      >
        {{ site.name }}
      </a>
    {% endif %}

    {% if not loop.last %}
      <span class="text-slate-300 select-none" aria-hidden="true">/</span>
    {% endif %}
  {% endfor %}
</nav>
