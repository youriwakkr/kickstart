{% extends '_layouts/_layout.twig' %}

{% block title %}Youri Gruiters | Fine Art & Landscape Photography{% endblock %}

{% block content %}

    <section class="space-y-6 mb-20">
        <div class="text-center max-w-3xl mx-auto">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-light text-zinc-900 tracking-tight leading-snug">
                {{ entry.title }}
            </h1>
        </div>

        <div class="w-full aspect-[16/9] sm:aspect-[21/9] overflow-hidden rounded-2xl bg-zinc-100 shadow-sm">
            <img
                src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=2000&q=85"
                alt="Atmospheric landscape photography"
                class="w-full h-full object-cover object-center"
            />
        </div>
    </section>

    <section class="my-20 pt-16 border-t border-zinc-200">
        <div class="flex items-end justify-between mb-8">
            <div>
                <p class="text-xs uppercase tracking-widest font-semibold text-zinc-400">Selected Series</p>
                <h2 class="text-2xl sm:text-3xl font-light text-zinc-900 tracking-tight mt-1">Nordic Light & Stillness</h2>
            </div>

            <div class="flex items-center gap-3">
                <button
                    type="button"
                    id="prev-slide-btn"
                    aria-label="Previous slide"
                    class="w-10 h-10 rounded-lg bg-white border border-zinc-300 flex items-center justify-center text-zinc-700 hover:text-zinc-950 hover:border-zinc-500 shadow-sm transition-all"
                >
                    <svg class="w-4 h-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
                    </svg>
                </button>
                <button
                    type="button"
                    id="next-slide-btn"
                    aria-label="Next slide"
                    class="w-10 h-10 rounded-lg bg-white border border-zinc-300 flex items-center justify-center text-zinc-700 hover:text-zinc-950 hover:border-zinc-500 shadow-sm transition-all"
                >
                    <svg class="w-4 h-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="relative w-full overflow-hidden rounded-2xl bg-zinc-900 shadow-md">
            <div class="hero-slide relative aspect-[16/9] w-full">
                <img
                    src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1800&q=80"
                    alt="Misty morning in mountain valley"
                    class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-zinc-950/85 to-transparent p-6 sm:p-10 flex items-baseline justify-between text-white">
                    <div>
                        <h3 class="text-lg font-medium">01 — Fjord Dawn</h3>
                        <p class="text-xs text-zinc-300 mt-1">Sognefjorden, Norway • 2026</p>
                    </div>
                    <span class="text-xs tracking-wider font-mono text-zinc-400">1 / 4</span>
                </div>
            </div>

            <div class="hero-slide hidden relative aspect-[16/9] w-full">
                <img
                    src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1800&q=80"
                    alt="Modern architectural glass facade"
                    class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-zinc-950/85 to-transparent p-6 sm:p-10 flex items-baseline justify-between text-white">
                    <div>
                        <h3 class="text-lg font-medium">02 — Linear Geometry</h3>
                        <p class="text-xs text-zinc-300 mt-1">Kyoto Architecture, Japan • 2026</p>
                    </div>
                    <span class="text-xs tracking-wider font-mono text-zinc-400">2 / 4</span>
                </div>
            </div>

            <div class="hero-slide hidden relative aspect-[16/9] w-full">
                <img
                    src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1800&q=80"
                    alt="Snowy peaks under starlight"
                    class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-zinc-950/85 to-transparent p-6 sm:p-10 flex items-baseline justify-between text-white">
                    <div>
                        <h3 class="text-lg font-medium">03 — Alpine Stillness</h3>
                        <p class="text-xs text-zinc-300 mt-1">Bernese Alps, Switzerland • 2025</p>
                    </div>
                    <span class="text-xs tracking-wider font-mono text-zinc-400">3 / 4</span>
                </div>
            </div>

            <div class="hero-slide hidden relative aspect-[16/9] w-full">
                <img
                    src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=80"
                    alt="Golden horizon at seaside"
                    class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-zinc-950/85 to-transparent p-6 sm:p-10 flex items-baseline justify-between text-white">
                    <div>
                        <h3 class="text-lg font-medium">04 — Atlantic Rim</h3>
                        <p class="text-xs text-zinc-300 mt-1">Algarve Coast, Portugal • 2025</p>
                    </div>
                    <span class="text-xs tracking-wider font-mono text-zinc-400">4 / 4</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-center gap-2 mt-6">
            <button class="w-3 h-3 rounded-full bg-zinc-900 transition-all dot-indicator" data-index="0" aria-label="Go to slide 1"></button>
            <button class="w-3 h-3 rounded-full bg-zinc-300 transition-all dot-indicator" data-index="1" aria-label="Go to slide 2"></button>
            <button class="w-3 h-3 rounded-full bg-zinc-300 transition-all dot-indicator" data-index="2" aria-label="Go to slide 3"></button>
            <button class="w-3 h-3 rounded-full bg-zinc-300 transition-all dot-indicator" data-index="3" aria-label="Go to slide 4"></button>
        </div>
    </section>

    {% if entry is defined and entry.pagebuilder is defined and entry.pagebuilder.exists() %}
        {% for block in entry.pagebuilder.all() %}
            {% include 'components/' ~ block.type.handle ignore missing with {block: block} %}
        {% endfor %}
    {% endif %}

    <section class="my-20 pt-16 border-t border-zinc-200">
        <div class="flex items-end justify-between mb-10">
            <div>
                <p class="text-xs uppercase tracking-widest font-semibold text-zinc-400">Blogs</p>
                <h2 class="text-2xl sm:text-3xl font-light text-zinc-900 tracking-tight mt-1">Field notes & essays</h2>
            </div>
            <a href="{{ currentSite.getBaseUrl() }}blogs" class="text-xs uppercase tracking-widest font-semibold text-zinc-900 hover:text-zinc-600 border-b border-zinc-900 pb-0.5 transition-colors">
                View All Entries &rarr;
            </a>
        </div>

        {% set latestBlogs = craft.entries().section('blogEntries').limit(2).all() %}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {% for blog in latestBlogs %}
                {% set blogImg = blog.image.one() ?? null %}
                <article class="bg-zinc-50 p-6 rounded-2xl border border-zinc-200 shadow-sm space-y-4">
                    {% if blogImg %}
                        <a href="{{ blog.url }}" class="block aspect-[16/10] overflow-hidden rounded-xl bg-zinc-100">
                            <img
                                src="{{ blogImg.url }}"
                                alt="{{ blogImg.alt ?? blogImg.title ?? blog.title }}"
                                class="w-full h-full object-cover hover:scale-102 transition-transform duration-500"
                            />
                        </a>
                    {% endif %}
                    <div class="text-xs text-zinc-400 tracking-wider uppercase pt-2">
                        {{ blog.postDate ? blog.postDate|date('F d, Y') : '' }}
                    </div>
                    <h3 class="text-xl font-medium text-zinc-900 hover:text-zinc-600 transition-colors">
                        <a href="{{ blog.url }}">
                            {{ blog.title }}
                        </a>
                    </h3>
                    {% if blog.paragraphs %}
                        <p class="text-sm text-zinc-500 font-light leading-relaxed">
                            {{ blog.paragraphs|striptags|truncate(150) }}
                        </p>
                    {% endif %}
                </article>
            {% else %}
                <p class="text-sm text-zinc-400 col-span-2">No blogs found.</p>
            {% endfor %}
        </div>
    </section>

    <script>
        (function () {
            const slides = document.querySelectorAll(".hero-slide");
            const dots = document.querySelectorAll(".dot-indicator");
            const prevBtn = document.getElementById("prev-slide-btn");
            const nextBtn = document.getElementById("next-slide-btn");
            let currentIndex = 0;

            function showSlide(index) {
                if (!slides.length) return;
                if (index < 0) index = slides.length - 1;
                if (index >= slides.length) index = 0;
                currentIndex = index;

                slides.forEach((slide, i) => {
                    if (i === currentIndex) {
                        slide.classList.remove("hidden");
                    } else {
                        slide.classList.add("hidden");
                    }
                });

                dots.forEach((dot, i) => {
                    if (i === currentIndex) {
                        dot.classList.remove("bg-zinc-300");
                        dot.classList.add("bg-zinc-900");
                    } else {
                        dot.classList.remove("bg-zinc-900");
                        dot.classList.add("bg-zinc-300");
                    }
                });
            }

            if (prevBtn && nextBtn) {
                prevBtn.addEventListener("click", () => showSlide(currentIndex - 1));
                nextBtn.addEventListener("click", () => showSlide(currentIndex + 1));
            }

            dots.forEach((dot) => {
                dot.addEventListener("click", (e) => {
                    const idx = parseInt(e.target.getAttribute("data-index"), 10);
                    showSlide(idx);
                });
            });
        })();
    </script>

{% endblock %}
