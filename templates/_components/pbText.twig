{# Text: heading, texteditor #}
{% if block.texteditor %}
  <section class="my-16 first:mt-0 max-w-3xl space-y-6">
    {% if block.heading %}
      <h2 class="text-2xl font-light tracking-tight text-zinc-900 sm:text-3xl text-balance">
        {{ block.heading }}
      </h2>
    {% endif %}

    {# The page already has its <h1>: rich-text H1s become <h2 data-h1> (styled as H1). Purified HTML, so raw is safe. #}
    <div class="rich-text">
      {{ block.texteditor|replace({ '<h1': '<h2 data-h1', '</h1>': '</h2>' })|raw }}
    </div>
  </section>
{% endif %}
