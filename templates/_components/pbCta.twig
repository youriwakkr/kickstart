{# Call to action: heading, simpleTexteditor, button #}
{# --focus-color: white focus outlines on the dark background (see src/css/app.css) #}
<section class="my-16 first:mt-0 rounded-2xl bg-zinc-900 px-8 py-14 text-center sm:px-12 [--focus-color:var(--color-white)]">
  <div class="mx-auto max-w-2xl space-y-6">
    <h2 class="text-2xl font-light tracking-tight text-white sm:text-3xl text-balance">
      {{ block.heading }}
    </h2>

    {% if block.simpleTexteditor %}
      <div class="rich-text rich-text-invert">
        {{ block.simpleTexteditor }}
      </div>
    {% endif %}

    {% if block.button and block.button.url %}
      <div class="pt-2">
        {% include '_partials/button.twig' with { link: block.button, variant: 'light' } only %}
      </div>
    {% endif %}
  </div>
</section>
