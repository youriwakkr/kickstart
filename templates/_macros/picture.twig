{#
  templates/_macros/picture.twig

  Renders an accessible, responsive <picture> element with AVIF and WebP sources
  and a fallback <img> in the original format. See picture-HOW-TO.twig for examples.

  Params:
  - image:         (Asset)  Craft asset [required]. Nothing is rendered when it's empty.
  - widths:        (Array)  Pixel widths for the srcset, e.g. [400, 800, 1200]. Widths larger than
                            the original image are skipped (no upscaling).
  - sizes:         (String) CSS sizes attribute, e.g. '(min-width: 1024px) 33vw, 100vw'. Default '100vw'.
  - ratio:         (String) Crop to an aspect ratio, 'W/H', e.g. '16/9' or '1/1'. Optional: without it
                            the image keeps its own proportions. Cropping respects the asset's focal point.
  - class:         (String) CSS classes for the <img>.
  - alt:           (String) Overrides the asset's alt text. Pass '' for decorative images.
  - loading:       (String) 'lazy' (default) or 'eager' (above-the-fold / LCP images).
  - fetchpriority: (String) 'high', 'low' or 'auto'. Defaults to 'high' when loading is 'eager'.

  SVG and GIF files are output as a plain <img> (no transforms).

  Choosing sizes + widths for this layout (container max-w-6xl = 1152px, px-8 padding → ~1088px content):

    Full width:  sizes: '100vw'
                 widths: [400, 800, 1200, 1600, 2000]

    2 columns:   sizes: '(min-width: 1152px) 544px, (min-width: 768px) 50vw, 100vw'
                 widths: [400, 640, 800, 1100, 1536]

    3 columns:   sizes: '(min-width: 1152px) 363px, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
                 widths: [360, 480, 720, 1024]

  Rule of thumb: the largest width ≈ the largest displayed width × 2 (for retina screens).
#}
{% macro picture(params) %}
  {%- set image = params.image ?? null -%}

  {%- if image and image.kind == 'image' -%}
    {%- set class = params.class ?? '' -%}
    {%- set loading = params.loading ?? 'lazy' -%}
    {%- set fetchpriority = params.fetchpriority ?? (loading == 'eager' ? 'high' : null) -%}
    {%- set alt = params.alt ?? image.alt ?? image.title -%}

    {%- if image.extension|lower in ['svg', 'gif'] -%}
      {# Vector and animated images: no transforms #}
      <img
        src="{{ image.url }}"
        {% if image.width and image.height %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
        alt="{{ alt }}"
        class="{{ class }}"
        loading="{{ loading }}"
        decoding="async"
        {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
      >
    {%- else -%}
      {%- set sizes = params.sizes ?? '100vw' -%}

      {# Aspect ratio (width / height): the requested crop, or the image's own proportions #}
      {%- set ratio = params.ratio ?? null -%}
      {%- if ratio -%}
        {%- set ratioParts = ratio|split('/') -%}
        {%- set aspect = ratioParts[0] / ratioParts[1] -%}
      {%- else -%}
        {%- set aspect = image.width / image.height -%}
      {%- endif -%}

      {# Largest width we can produce without upscaling (cropping can limit it by height) #}
      {%- set maxWidth = min(image.width, (image.height * aspect)|round(0, 'floor')) -%}

      {%- set widths = (params.widths ?? [400, 800, 1200])|filter(w => w <= maxWidth)|sort -%}
      {%- if widths is empty -%}
        {%- set widths = [maxWidth] -%}
      {%- endif -%}
      {%- set largest = widths|last -%}
      {%- set largestHeight = (largest / aspect)|round -%}

      {# Base transform at the largest width. With a height set, Craft keeps this ratio for every srcset width. #}
      {%- set transform = { mode: 'crop', width: largest } -%}
      {%- if ratio -%}
        {%- set transform = transform|merge({ height: largestHeight }) -%}
      {%- endif -%}

      {%- set srcsetWidths = widths|map(w => w ~ 'w') -%}

      <picture>
        <source type="image/avif" srcset="{{ image.getSrcset(srcsetWidths, transform|merge({ format: 'avif' })) }}" sizes="{{ sizes }}">
        <source type="image/webp" srcset="{{ image.getSrcset(srcsetWidths, transform|merge({ format: 'webp' })) }}" sizes="{{ sizes }}">
        <img
          src="{{ image.getUrl(transform|merge({ width: widths|first, height: ratio ? (widths|first / aspect)|round : null })) }}"
          srcset="{{ image.getSrcset(srcsetWidths, transform) }}"
          sizes="{{ sizes }}"
          width="{{ largest }}"
          height="{{ largestHeight }}"
          alt="{{ alt }}"
          class="{{ class }}"
          loading="{{ loading }}"
          decoding="async"
          {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
        >
      </picture>
    {%- endif -%}
  {%- endif -%}
{% endmacro %}
