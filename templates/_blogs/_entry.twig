{% extends '_layouts/_layout.twig' %}

{% block title %}{{ entry.title }} | Youri Gruiters Photography{% endblock %}

{% block content %}

    <div class="mb-10">
        <a
            href="{{ currentSite.getBaseUrl() }}blogs"
            class="text-xs uppercase tracking-widest font-semibold text-zinc-400 hover:text-zinc-900 transition-colors inline-flex items-center gap-2"
        >
            <span>&larr;</span>
            <span>Back to Blogs</span>
        </a>
    </div>

    <header class="space-y-4 mb-12 pb-8 border-b border-zinc-200">
        <div class="text-xs uppercase tracking-wider text-zinc-400">
            {{ entry.postDate ? entry.postDate|date('F d, Y') : '' }}
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light text-zinc-900 tracking-tight leading-tight">
            {{ entry.title }}
        </h1>
    </header>

    {% set entryImage = entry.image.one() ?? null %}
    {% if entryImage %}
        <div class="mb-14">
            <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-zinc-100 shadow-sm">
                <img
                    src="{{ entryImage.url }}"
                    alt="{{ entryImage.alt ?? entryImage.title ?? entry.title }}"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    {% endif %}

    {% if entry.paragraphs %}
        <div class="max-w-3xl mx-auto space-y-6 text-zinc-700 font-light text-lg sm:text-xl leading-relaxed whitespace-pre-line">
            {{ entry.paragraphs }}
        </div>
    {% endif %}

    {% set nextEntry = craft.entries().section('blogEntries').id('not ' ~ entry.id).one() %}
    <footer class="mt-16 pt-8 border-t border-zinc-200 flex flex-col sm:flex-row items-baseline justify-between gap-4">
        {% if nextEntry %}
            <div>
                <span class="text-xs uppercase tracking-widest text-zinc-400">Other Blog</span>
                <h3 class="text-lg font-medium text-zinc-900 mt-1 hover:text-zinc-600 transition-colors">
                    <a href="{{ nextEntry.url }}">
                        {{ nextEntry.title }} &rarr;
                    </a>
                </h3>
            </div>
        {% else %}
            <div></div>
        {% endif %}
        <a href="{{ currentSite.getBaseUrl() }}blogs" class="text-xs uppercase tracking-widest font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">
            All blogs
        </a>
    </footer>

{% endblock %}
