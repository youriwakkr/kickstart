<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <title>{{ siteName }}</title>

    {# Load our main CSS file in dev mode to avoid FOUC #}
    {# {% if craft.vite.devServerRunning() %}
        <link rel="stylesheet" href="{{ craft.vite.asset("src/css/app.css") }}">
    {% endif %} #}

    {# {{ craft.vite.script("src/css/app.css") }} #}

    {# Vite #}
    {{ craft.vite.script('src/js/app.js') }}
</head>
<body class="ltr">

    <header class="flex items-center justify-between px-6 py-4 border-b">
        <a href="{{ currentSite.getBaseUrl() }}" class="font-bold">
            Website: {{ currentSite.name }}
        </a>

        {% include '_partials/language-switcher.twig' %}
    </header>

    {% block body %}
    {% endblock %}
</body>
</html>
