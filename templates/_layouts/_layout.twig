<!DOCTYPE html>
<html lang="{{ currentSite.language ?? 'en' }}" class="h-full scroll-smooth">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="referrer" content="origin-when-cross-origin"/>

    {# Google Tag Manager: waiting for a container ID. Set GTM_ID=GTM-XXXXXXX in .env to enable (see config/custom.php). #}
    {% set gtmId = craft.app.config.custom.gtmId ?? null %}
    {% if gtmId %}
      <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ gtmId|e('js') }}');</script>
    {% endif %}

    {# Fallback <title>, canonical and hreflang. Skipped automatically once SEOmatic or SEOMate is enabled. #}
    {% include '_partials/seo-head.twig' with { entry: entry ?? null } only %}

    {# SEOMate outputs its meta tags (incl. <title>) here. Outputs nothing when SEOMate isn't installed. SEOmatic injects its tags itself. #}
    {% hook 'seomateMeta' %}

    {{ craft.vite.script('src/js/app.js', false) }}
  </head>
  <body class="min-h-full flex flex-col bg-white text-zinc-800 font-sans antialiased">
    {% if gtmId %}
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ gtmId|url_encode }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    {% endif %}

    {% include '_partials/header.twig' with { entry: entry ?? null } only %}

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      {% block content %}

      {% endblock %}
    </main>

    {% include '_partials/footer.twig' only %}

  </body>
</html>
