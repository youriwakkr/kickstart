# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html
#
# Copy this file to .env and fill it in. The defaults below are for local development (DDEV).
# On staging/production, change these values:
#
#   Setting                     dev     staging   production
#   CRAFT_ENVIRONMENT           dev     staging   production
#   CRAFT_DEV_MODE              true    false     false
#   CRAFT_ALLOW_ADMIN_CHANGES   true    false     false
#   CRAFT_DISALLOW_ROBOTS       true    true      false
#   GTM_ID                      (empty) (empty)   GTM-XXXXXXX

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Site URLs (used by the sites and the Images volume in project config)
PRIMARY_SITE_UPLOADS_URL=https://website.ddev.site/uploads
PRIMARY_SITE_URL=https://website.ddev.site/
PRIMARY_SITE_URL_EN=https://website.ddev.site/en/

# Database connection settings
# DDEV provides these locally, so they're only needed on staging/production. Uncomment and fill in there.
# CRAFT_DB_DRIVER=mysql
# CRAFT_DB_SERVER=127.0.0.1
# CRAFT_DB_PORT=3306
# CRAFT_DB_DATABASE=
# CRAFT_DB_USER=
# CRAFT_DB_PASSWORD=
# CRAFT_DB_TABLE_PREFIX=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable GTM.
GTM_ID=
